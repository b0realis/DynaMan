<svg xmlns="http://www.w3.org/2000/svg" width="64" height="76" viewBox="0 0 64 76">
  <!-- Defeat face: front view, eyes screwed shut, waterfall tears. -->
  <ellipse cx="32" cy="72" rx="16" ry="4" fill="#000" opacity="0.15"/>
  <ellipse cx="24" cy="68" rx="7" ry="4.5" fill="%DARK%" stroke="#1a1626" stroke-width="2"/>
  <ellipse cx="40" cy="68" rx="7" ry="4.5" fill="%DARK%" stroke="#1a1626" stroke-width="2"/>
  <path d="M22 46 H42 C45 46 46 49 46 52 V58 C46 62 43 63 40 63 H24 C21 63 18 62 18 58 V52 C18 49 19 46 22 46 Z" fill="%COL%" stroke="#1a1626" stroke-width="2.5"/>
  <rect x="30.3" y="46.8" width="3.4" height="9.6" rx="1.4" fill="#f4f4f6" stroke="#1a1626" stroke-width="1.2"/>
  <path d="M30.3 50 H33.7 M30.3 52.6 H33.7 M30.3 55.2 H33.7" stroke="#8d8d9e" stroke-width="1"/><rect x="19" y="55.4" width="26" height="2.6" fill="#2a2433" stroke="#1a1626" stroke-width="1"/><rect x="29.2" y="54.4" width="5.6" height="4.6" rx="1.1" fill="#f2c94c" stroke="#8a6a10" stroke-width="1.2"/>
  <circle cx="32" cy="48.6" r="1.7" fill="#1a1626"/>
  <!-- arms drooped low, palms down -->
  <circle cx="13" cy="56" r="5.5" fill="#f4f4f4" stroke="#1a1626" stroke-width="2"/>
  <circle cx="51" cy="56" r="5.5" fill="#f4f4f4" stroke="#1a1626" stroke-width="2"/>
  <!-- antenna wilts -->
  <path d="M32 8 C32 5 34 4 36 4.5" stroke="#1a1626" stroke-width="2.5" fill="none"/>
  <circle cx="37.5" cy="5.5" r="3.4" fill="%COL%" stroke="#1a1626" stroke-width="1.5"/>
  <circle cx="32" cy="28" r="21" fill="%COL%" stroke="#1a1626" stroke-width="2.5"/>
  <ellipse cx="23" cy="15" rx="7" ry="4" fill="#ffffff" opacity="0.3"/>
  <rect x="17.5" y="26.5" width="29" height="14.5" rx="7" fill="#f6d3a7" stroke="#1a1626" stroke-width="2"/>
  <!-- eyes screwed shut (sad upside-down arcs + knit brows) -->
  <path d="M24 34.5 Q27 31 30 34.5" fill="none" stroke="#1a1626" stroke-width="2.4" stroke-linecap="round"/>
  <path d="M34 34.5 Q37 31 40 34.5" fill="none" stroke="#1a1626" stroke-width="2.4" stroke-linecap="round"/>
  <path d="M24.5 29.5 L29.5 31 M39.5 29.5 L34.5 31" stroke="#1a1626" stroke-width="1.8" stroke-linecap="round"/>
  <!-- waterfall tears: streams out of both eyes, over the window rim -->
  <path d="M25.5 35 C25 38.5 24.5 41 24 44.5 L28 44.5 C27.6 41 27.4 38.5 27.3 35 Z" fill="#7fd4f2" opacity="0.9"/>
  <path d="M36.7 35 C36.5 38.5 36.3 41 36 44.5 L40 44.5 C39.6 41 39 38.5 38.5 35 Z" fill="#7fd4f2" opacity="0.9"/>
  <ellipse cx="26" cy="45.5" rx="2.4" ry="1.4" fill="#7fd4f2" opacity="0.75"/>
  <ellipse cx="38" cy="45.5" rx="2.4" ry="1.4" fill="#7fd4f2" opacity="0.75"/>
</svg>
