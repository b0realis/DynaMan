<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64">
  <!-- battle bomb, style "potion": round glass bottle, flat bottom,
       corked neck, bubbling liquid in the player's colour. No wick —
       the runtime bubble particles ARE the fuse; the cork pops just
       before the boom (see _tick_bombs). Liquid surface bows down,
       house perspective rule. -->
  <ellipse cx="32" cy="60.5" rx="12.5" ry="2.8" fill="#000" opacity="0.18"/>
  <!-- liquid, behind the glass -->
  <path d="M23.4 54.5 A17 17 0 0 1 15.1 35.5 Q32 40.5 48.9 35.5 A17 17 0 0 1 40.6 54.5 Z" fill="%COL%"/>
  <path d="M15.1 35.5 Q32 40.5 48.9 35.5 Q32 37.6 15.1 35.5 Z" fill="#ffffff" opacity="0.35"/>
  <path d="M22 50 Q32 55 42 50 L40.9 54.3 Q32 57 23.1 54.3 Z" fill="%DARK%" opacity="0.55"/>
  <g fill="#ffffff" opacity="0.4">
    <circle cx="24" cy="43" r="2.2"/><circle cx="37" cy="45" r="1.6"/><circle cx="31" cy="39.5" r="1.3"/>
    <circle cx="42" cy="40" r="1.8"/><circle cx="20" cy="38.5" r="1.1"/>
  </g>
  <!-- glass bulb (flat bottom) + neck, translucent -->
  <path d="M22.6 56.5 A19 19 0 1 1 41.4 56.5 Z" fill="#cfe4ee" opacity="0.28"/>
  <path d="M22.6 56.5 A19 19 0 1 1 41.4 56.5 Z" fill="none" stroke="#101018" stroke-width="2.4"/>
  <rect x="27" y="9.5" width="10" height="13" fill="#cfe4ee" opacity="0.28"/>
  <rect x="27" y="9.5" width="10" height="13" fill="none" stroke="#101018" stroke-width="2.2"/>
  <rect x="25" y="8" width="14" height="4" rx="2" fill="#b8ccd8" stroke="#101018" stroke-width="1.8"/>
  <path d="M19 30 Q17.5 36 19.5 42 Q15.5 36 17.5 30 Z" fill="#ffffff" opacity="0.4"/>
  <!-- cork -->
  <rect x="27.8" y="1.5" width="8.4" height="8" rx="2" fill="#b08954" stroke="#5f4426" stroke-width="1.8"/>
  <ellipse cx="32" cy="2.4" rx="4.2" ry="1.5" fill="#c9a06a"/>
  <path d="M30 4 L30 8.5 M34 4 L34 8.5" stroke="#8a6a3c" stroke-width="1" fill="none"/>
</svg>
